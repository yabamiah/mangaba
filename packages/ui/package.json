{
  "name": "@pequiplan/ui",
  "version": "0.1.0",
  "description": "MeriHari Design System - React component library inspired by Hobonichi paper aesthetics",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/tokens": "./dist/styles/tokens.css",
    "./styles/utilities": "./dist/styles/utilities.css",
    "./styles/patterns": "./dist/styles/patterns.css",
    "./styles/themes": "./dist/styles/themes.css",
    "./buttons": {
      "import": "./dist/components/buttons/index.js",
      "types": "./dist/components/buttons/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./tailwind": {
      "import": "./dist/tailwind/preset.js",
      "types": "./dist/tailwind/preset.d.ts"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^0.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.6.2"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "merihari",
    "hobonichi",
    "paper",
    "pequiplan",
    "components"
  ]
}
