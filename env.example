# Mangaba environment example
#
# MangaDex public endpoints used by this app do not require an API token for
# search, manga metadata, feeds, covers, or MangaDex@Home page URLs.
# Fill this only if you later add authenticated MangaDex features.
MANGADEX_API_TOKEN=

# Explicit User-Agent required by the project/API compliance rules.
MANGADEX_USER_AGENT="Mangaba/0.1.0 (+local desktop app)"

# Base URLs kept configurable for tests and future API changes.
MANGADEX_API_BASE_URL="https://api.mangadex.org"
MANGADEX_COVERS_BASE_URL="https://uploads.mangadex.org/covers"
